# Database Configuration
POSTGRES_DB=tourism_db
POSTGRES_USER=tourism_user
POSTGRES_PASSWORD=tourism_password

# Authentication & Security
JWT_SECRET=your-jwt-base64-secret-here
JWT_EXPIRATION_MS=86400000
JWT_GUEST_EXPIRATION_MS=604800000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Telegram Bot (OTP Service)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_CHAT_ID=your-telegram-chat-id-here

# External API Keys
MAP_API_KEY=your-map-api-key
GEMINI_API_KEY=your-gemini-api-key
WEATHER_API_KEY=your-weather-api-key
TTS_API_KEY=your-tts-api-key
API_KEY=your-general-api-key
